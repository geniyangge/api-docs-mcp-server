# npm 发版脚本环境变量
# - __sh/release.cjs：更新版本号 + npm publish
# - __sh/git-push.cjs（postpublish 钩子）：发布成功后 commit 版本变更、打 tag、push，以下 git 变量供其使用

# 环境变量文件（可选）：默认读取项目根 .env；可指定其他文件名实现多环境切换，
# 如 ENV_FILE=.env.prod。shell 里已设置的变量优先级高于文件内容
# ENV_FILE=.env

# git 提交身份（必需）：脚本使用 -c 注入，不修改任何 git config，也不入库
GIT_USER_NAME=your-git-name
GIT_USER_EMAIL=your-git-email@example.com

# 远程仓库（可选）：缺省使用仓库已有的 remote（如 origin）
# GIT_REMOTE_NAME=origin
# GIT_REMOTE_URL=https://github.com/your-name/api-docs-mcp-server.git

# 允许发布的分支（可选，默认 master；release 脚本使用）
# GIT_RELEASE_BRANCH=master

# 演练模式（可选）：置为非空值时只打印将执行的命令，不落任何改动
# RELEASE_DRY_RUN=1